# Application
APP_NAME=Virtual Fashion Try-On
APP_VERSION=1.0.0
DEBUG=true

# MongoDB
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fashion_tryon

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Cloudinary (optional - leave empty for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (optional - leave empty for in-memory rate limiting)
REDIS_URL=

# Gemini API (optional - mock used if empty)
GEMINI_API_KEY=

# Server
HOST=0.0.0.0
PORT=10000
